# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Required ────────────────────────────────────────────────────────────────

# TinyFish web agent key — https://tinyfish.ai
TINYFISH_API_KEY=your_tinyfish_key_here

# LLM provider key used for profile extraction, ranking and report writing
LLM_API_KEY=your_llm_key_here

# ── LLM settings ────────────────────────────────────────────────────────────

# Which LLM provider to use: gemini | openai
LLM_PROVIDER=gemini

# Model name override (defaults per provider are set in config.py)
# LLM_MODEL=gemini-3.8-flash

# ── Feature flags ───────────────────────────────────────────────────────────

# Optional: override the LLM endpoint (must be OpenAI-compatible). If unset,
# defaults apply: openai -> https://api.openai.com/v1, gemini -> Google's
# OpenAI-compatible endpoint (https://generativelanguage.googleapis.com/v1beta/openai).
# The Neon AI Gateway is used instead when its credentials are provisioned.
LLM_BASE_URL=

# Optional: override the model id, e.g. gemini-2.0-flash / gpt-4o-mini
LLM_MODEL=

# Set to true to skip live agent calls and return saved mock results
DEMO_MODE=false

# ── Discovery ───────────────────────────────────────────────────────────────

# Comma-separated fallback URLs for discovery when GitHub extraction returns nothing
# DISCOVERY_FALLBACK_URLS=https://goodfirstissue.dev/language/python

# ── Tuning ──────────────────────────────────────────────────────────────────

# Max wall-clock seconds to wait for a single TinyFish run
TINYFISH_TIMEOUT=120

# Max parallel TinyFish runs (set lower on free-tier hosts to avoid OOM)
TINYFISH_MAX_CONCURRENT=3

# Max seconds to wait for a single LLM response
LLM_TIMEOUT=30
