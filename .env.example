# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# TinyFish web agent key — https://tinyfish.ai
TINYFISH_API_KEY=your_tinyfish_key_here

# LLM provider key used for profile extraction, ranking and report writing
LLM_API_KEY=your_llm_key_here

# Which LLM provider to use: gemini | openai
LLM_PROVIDER=gemini

# Set to true to skip live agent calls and return saved mock results
DEMO_MODE=false

# Comma-separated fallback URLs for discovery when GitHub extraction returns nothing
# DISCOVERY_FALLBACK_URLS=https://goodfirstissue.dev/language/python

# Optional tuning — defaults shown
TINYFISH_TIMEOUT=120
TINYFISH_MAX_CONCURRENT=3
LLM_TIMEOUT=30
